# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Postgres (host port 5433 maps to 5432 in the container)
POSTGRES_USER=sahyog
POSTGRES_PASSWORD=sahyog-dev
POSTGRES_DB=sahyog
DATABASE_URL=postgresql+psycopg://sahyog:sahyog-dev@postgres:5432/sahyog
TEST_DATABASE_URL=postgresql+psycopg://sahyog:sahyog-dev@postgres:5432/sahyog_test

# Redis (host port 6380)
REDIS_URL=redis://redis:6379/0

# MinIO object store (host ports 9100 API, 9101 console)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=sahyog
MINIO_ROOT_PASSWORD=sahyog-dev-secret
MINIO_SECURE=false

# Dev token signing secret: local only, replaced by OIDC in a real deployment
JWT_SECRET=local-dev-only-secret-replace-for-any-shared-env
JWT_TTL_MINUTES=480

# Seed scale (defaults match the S0 stage doc)
SEED_RANDOM_SEED=42

# Model gateway. S1 runs entirely on the fake model; set LLM_PROVIDER=anthropic and add your key
# only for `make llm-smoke` or from S2. The key never goes in git.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
